{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "avoid",
  "bracketSpacing": true,
  "jsxSingleQuote": false,
  "printWidth": 120,
  "quoteProps": "as-needed",
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false,
  "endOfLine": "lf",
  "sortImports": true,
  "sortPackageJson": false,
  "ignorePatterns": ["dist/**", "pnpm-lock.yaml", ".scratch/**", "src/**/fixtures/*.html"]
}
